NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Must match the URL you use in the browser (including port 3000).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase Dashboard → Authentication → URL configuration (required for email verification):
# Site URL: http://localhost:3000
# Redirect URLs (add every URL exactly):
#   http://localhost:3000/auth/callback
#   http://127.0.0.1:3000/auth/callback
#
# signUp() sets emailRedirectTo to: ${NEXT_PUBLIC_APP_URL}/auth/callback
# After the user confirms email, the app route /auth/callback verifies and sends them to /login?verified=1
#
# Run the dev server before clicking the email link: npm run dev (port 3000)
# Apply database schema in Supabase SQL Editor (in order — required before Dashboard history works):
#   1. supabase/migrations/001_profiles_and_compression_history.sql
#      → creates profiles, compression_history, user_settings + RLS + signup trigger
#   2. supabase/migrations/002_storage_buckets_and_policies.sql
#      → creates avatars + compression-outputs buckets and storage policies
# See also: supabase/migrations/README.md
